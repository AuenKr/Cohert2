{
  "id": null,
  "title": "k6 Load Test – Final",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Active VUs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(k6_vus)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Max VUs",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(k6_vus_max)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Iterations / sec",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(k6_iterations[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Duration – Global (p50 / p95 / p99)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "avg(k6_http_req_duration{quantile=\"0.5\"})",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "avg(k6_http_req_duration{quantile=\"0.95\"})",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "avg(k6_http_req_duration{quantile=\"0.99\"})",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time To First Byte (TTFB) – Global (p50 / p95 / p99)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "avg(k6_http_req_waiting{quantile=\"0.5\"})",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "avg(k6_http_req_waiting{quantile=\"0.95\"})",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "avg(k6_http_req_waiting{quantile=\"0.99\"})",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Iteration Duration (p95)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "avg(k6_iteration_duration{quantile=\"0.95\"})",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed Requests / sec",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(k6_http_req_failed_count[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Data Sent / Received (bytes/sec)",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(k6_data_sent[1m]))",
          "legendFormat": "sent",
          "refId": "A"
        },
        {
          "expr": "sum(rate(k6_data_received[1m]))",
          "legendFormat": "received",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "k6 CPU usage (cores)",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(process_cpu_seconds_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "k6 Memory usage (MB)",
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(go_memstats_alloc_bytes) / 1024 / 1024",
          "legendFormat": "MB",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(go_goroutines)",
          "refId": "A"
        }
      ]
    }
  ]
}
